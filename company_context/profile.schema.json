{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alfa-news-agent:company-profile:1.0",
  "title": "Company business context 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "company_id",
    "industry",
    "scale",
    "company_attributes",
    "bank_products",
    "foreign_trade",
    "geography",
    "dataset_position",
    "group",
    "related_companies",
    "related_companies_total",
    "related_companies_truncated",
    "counterparties",
    "payment_summary",
    "data_quality",
    "provenance",
    "relevance_signals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "object",
      "required": [
        "okved_code",
        "name",
        "sector",
        "okved_division"
      ],
      "properties": {
        "okved_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sector": {
          "type": [
            "string",
            "null"
          ]
        },
        "okved_division": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scale": {
      "type": "object",
      "required": [
        "revenue_raw",
        "revenue_unit",
        "revenue_rub",
        "is_large_business",
        "employees_band",
        "employees_fns_band",
        "employees_spark_band"
      ],
      "properties": {
        "revenue_raw": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "revenue_unit": {
          "enum": [
            "unknown",
            "rub",
            "thousand_rub"
          ]
        },
        "revenue_rub": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "is_large_business": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "employees_band": {
          "type": [
            "string",
            "null"
          ]
        },
        "employees_fns_band": {
          "type": [
            "string",
            "null"
          ]
        },
        "employees_spark_band": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "company_attributes": {
      "type": "object"
    },
    "bank_products": {
      "type": "object",
      "required": [
        "rko",
        "guarantee",
        "loan",
        "leasing",
        "deposit",
        "payroll",
        "factoring"
      ],
      "properties": {
        "rko": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "guarantee": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "loan": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "leasing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "deposit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "payroll": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "factoring": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "foreign_trade": {
      "type": "object",
      "required": [
        "has_fts",
        "countries",
        "trade_direction",
        "currencies"
      ],
      "properties": {
        "has_fts": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "trade_direction": {
          "type": "null"
        },
        "currencies": {
          "type": "null"
        }
      }
    },
    "geography": {
      "type": "object",
      "required": [
        "city",
        "region"
      ],
      "properties": {
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dataset_position": {
      "type": "object",
      "required": [
        "available",
        "market_share"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "market_share": {
          "type": "null"
        },
        "share_of_observed_revenue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "members",
        "members_total",
        "members_truncated",
        "source"
      ],
      "properties": {
        "group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members_total": {
          "type": "integer",
          "minimum": 0
        },
        "members_truncated": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "required": [
            "source",
            "file",
            "records",
            "records_total",
            "records_truncated"
          ],
          "properties": {
            "source": {
              "enum": [
                "companies",
                "links",
                "payments"
              ]
            },
            "file": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 2
              }
            },
            "records_total": {
              "type": "integer",
              "minimum": 0
            },
            "records_truncated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "related_companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company_id",
          "shared_people_count",
          "source"
        ],
        "properties": {
          "company_id": {
            "type": "string"
          },
          "shared_people_count": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "object",
            "required": [
              "source",
              "file",
              "records",
              "records_total",
              "records_truncated"
            ],
            "properties": {
              "source": {
                "enum": [
                  "companies",
                  "links",
                  "payments"
                ]
              },
              "file": {
                "type": "string"
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 2
                }
              },
              "records_total": {
                "type": "integer",
                "minimum": 0
              },
              "records_truncated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "related_companies_total": {
      "type": "integer",
      "minimum": 0
    },
    "related_companies_truncated": {
      "type": "boolean"
    },
    "counterparties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company_id",
          "direction",
          "pay_amount",
          "pay_count",
          "share_of_direction",
          "role",
          "company_card_available",
          "industry",
          "source"
        ],
        "properties": {
          "company_id": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "pay_amount": {
            "type": "number",
            "minimum": 0
          },
          "pay_count": {
            "type": "integer",
            "minimum": 0
          },
          "share_of_direction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "role": {
            "enum": [
              "получатель платежей",
              "отправитель платежей"
            ]
          },
          "company_card_available": {
            "type": "boolean"
          },
          "industry": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "required": [
              "source",
              "file",
              "records",
              "records_total",
              "records_truncated"
            ],
            "properties": {
              "source": {
                "enum": [
                  "companies",
                  "links",
                  "payments"
                ]
              },
              "file": {
                "type": "string"
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 2
                }
              },
              "records_total": {
                "type": "integer",
                "minimum": 0
              },
              "records_truncated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "payment_summary": {
      "type": "object",
      "required": [
        "available",
        "incoming_amount",
        "outgoing_amount",
        "counterparties_truncated",
        "concentration",
        "currency",
        "period"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "incoming_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outgoing_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "null"
        },
        "period": {
          "type": "null"
        }
      }
    },
    "data_quality": {
      "type": "object",
      "required": [
        "missing_fields",
        "warnings",
        "conflicting_fields",
        "company_records_total"
      ],
      "properties": {
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "company_records_total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "company",
        "company_raw_fields",
        "sources",
        "snapshot_built_at",
        "signal_method",
        "company_record_variants"
      ],
      "properties": {
        "company": {
          "type": "object",
          "required": [
            "source",
            "file",
            "records",
            "records_total",
            "records_truncated"
          ],
          "properties": {
            "source": {
              "enum": [
                "companies",
                "links",
                "payments"
              ]
            },
            "file": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 2
              }
            },
            "records_total": {
              "type": "integer",
              "minimum": 0
            },
            "records_truncated": {
              "type": "boolean"
            }
          }
        },
        "company_raw_fields": {
          "type": "object"
        },
        "company_record_variants": {
          "type": "array"
        },
        "sources": {
          "type": "object"
        },
        "signal_method": {
          "const": "deterministic_rules_v1"
        }
      }
    },
    "relevance_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "reason",
          "weight",
          "evidence",
          "entities"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
